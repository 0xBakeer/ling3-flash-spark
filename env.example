# ---------------------------------------------------------------------------
# Ling-3.0-flash on a single NVIDIA DGX Spark (GB10 / sm_121, 121 GiB unified)
# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value here is also overridable from the
# environment: PROFILE=cookbook ./start.sh

# --- what to serve -------------------------------------------------------
MODEL_DIR="$HOME/models/Ling-3.0-flash-fp4"        # MXFP4 experts + FP8 attention
DRAFT_DIR="$HOME/models/Ling-3.0-flash-dspark"     # DSpark drafter (1.36B, BF16)
SERVED_MODEL_NAME="ling-3.0-flash"
HOST=0.0.0.0
PORT=30000

# --- profile -------------------------------------------------------------
# cookbook       SGLang cookbook's verified dgx-spark cell: flashinfer_mxfp4 + DSPARK.
# humming-nextn  Ant/NVIDIA notebook: humming MoE + online FP8 LM head + NEXTN-3.
# humming-dspark THIS RECIPE: humming MoE + online FP8 LM head + DSPARK.
PROFILE=humming-dspark

# --- memory --------------------------------------------------------------
# The single most dangerous knob on this box. The Ant/NVIDIA notebook warns
# that 0.75 "risks GPU OOM and driver lockups" and recommends 0.68; the SGLang
# cookbook's own dgx-spark cell ships 0.85. Exhausting the unified pool wedges
# the kernel with no OOM message and no logs, so we climb from below.
MEM_FRACTION_STATIC=0.75

# --- thinking ------------------------------------------------------------
# Ling's chat template is binary (on/off, no effort levels) and DEFAULTS to on.
# Thinking on is the recommended setting: it is both more accurate (up to +31
# points on eval-reasoning-v2) and FASTER on this stack, because the DSpark
# drafter predicts the model's reasoning style better than terse answers.
# Setting it as a server default (not per request) makes it part of the config.
DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking": true}'

# --- context -------------------------------------------------------------
# Native 256K. SGLang reads max_position_embeddings (262144) straight from the
# checkpoint, so no --context-length is needed and none is passed.
# YARN_OVERRIDE=1 replays the Ant notebook's rope_scaling override. Leave it 0:
# the checkpoint declares rope_scaling=null at a native 262144, so forcing YaRN
# factor 2.0 on top re-scales rope the model was never trained with.
YARN_OVERRIDE=0

# --- serving shape (low-latency, single stream) --------------------------
MAX_RUNNING_REQUESTS=1
MAX_MAMBA_CACHE_SIZE=64
CHUNKED_PREFILL_SIZE=8192
MAX_PREFILL_TOKENS=16384
PAGE_SIZE=64
RANDOM_SEED=308534008

# --- parsers -------------------------------------------------------------
# Ling-3.0-flash emits GLM-4.5-style XML tool calls
# (<tool_call>name <arg_key>k</arg_key><arg_value>v</arg_value>...). Only the
# `ling3` detector parses that; `qwen25` expects JSON and lets the call fall
# through as plain text. Both `ling3` parsers ship on the inclusionAI branch.
REASONING_PARSER=ling3
TOOL_CALL_PARSER=ling3
